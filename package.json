{
  "name": "vid-vision",
  "productName": "Vid Vision",
  "version": "1.3.0",
  "description": "Vid Vision \u2014 Vision Engine, Voice Engine and Scribe Engine in one desktop app.",
  "author": "5 Dollar Friday",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && electron .",
    "check": "node scripts/check.js",
    "dist:win": "npm run check && npm run build:renderer && node scripts/fetch-win-bins.js && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run check && npm run build:renderer && node scripts/fetch-mac-bins.js && electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "docx": "9.15.4",
    "mammoth": "1.13.0",
    "marked": "18.2.1",
    "pdfjs-dist": "4.10.38",
    "phonemize": "^2.0.1",
    "phonemizer": "1.2.1",
    "sherpa-onnx-node": "^2.0.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "htm": "3.1.1",
    "kokoro-js": "1.2.1",
    "mermaid": "^12.3.0",
    "preact": "11.2.0",
    "resedit": "3.1.1"
  },
  "build": {
    "appId": "com.fivedollarfriday.vidvision",
    "productName": "Vid Vision",
    "copyright": "Copyright \u00a9 2026 5 Dollar Friday",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "config/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "dist/renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!node_modules/@napi-rs/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/*.d.mts",
      "!node_modules/docx/dist/*.iife.js",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "config/app.json",
        "to": "app-config.json"
      }
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Vid-Vision-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin/win",
          "to": "bin",
          "filter": [
            "*.exe"
          ]
        }
      ],
      "files": [
        "!node_modules/sherpa-onnx-linux-*/**",
        "!node_modules/sherpa-onnx-darwin-*/**",
        "!node_modules/sherpa-onnx-win-arm64/**",
        "!node_modules/sherpa-onnx-win-ia32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vid Vision",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Vid Vision records your voice when you choose to record a voice sample or narration."
      },
      "extraResources": [
        {
          "from": "resources/bin/mac-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        }
      ],
      "files": [
        "!node_modules/sherpa-onnx-linux-*/**",
        "!node_modules/sherpa-onnx-win-*/**"
      ],
      "artifactName": "Vid-Vision-${version}-${arch}.${ext}",
      "notarize": false
    },
    "dmg": {
      "artifactName": "Vid-Vision-${version}-${arch}.${ext}",
      "title": "Vid Vision ${version}"
    }
  }
}
